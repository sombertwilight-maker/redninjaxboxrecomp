+    sl->at = s_fsnap_pos; sl->bytes = bytes; sl->used = 0;
+    memcpy(s_fsnap_buf + s_fsnap_pos, mem + base + start, bytes);
+    s_fsnap_pos += (bytes + 3u) & ~3u;
+    s_fsnap_head = (s_fsnap_head + 1u) % FIX_SNAP_SLOTS;
