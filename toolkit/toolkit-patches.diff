+static DWORD WINAPI mw_thread(LPVOID unused)
+{
+    FILETIME last = { 0, 0 };
+    WIN32_FILE_ATTRIBUTE_DATA fa0;
+    (void)unused;
+    /* The file was already read and armed synchronously in
+     * xbox_MemWatchStart, so start from its current time: re-arming here
+     * would clear the hit count and the seen table a few hundred
+     * milliseconds in, which is where a title's startup allocations and
+     * their first fill land. */
+    if (GetFileAttributesExA("memwatch.txt", GetFileExInfoStandard, &fa0))
+        last = fa0.ftLastWriteTime;
+    for (;;) {
+        WIN32_FILE_ATTRIBUTE_DATA fa;
+        Sleep(500);
+        if (!GetFileAttributesExA("memwatch.txt", GetFileExInfoStandard, &fa)
+            || !memcmp(&fa.ftLastWriteTime, &last, sizeof last))
+            continue;
+        last = fa.ftLastWriteTime;
+        mw_arm_from_file();
+    }
+    return 0;
+}
+
+void xbox_MemWatchStart(void)
+{
+    const char *e = getenv("RECOMP_MEMWATCH");
+    if (e && *e && *e != '0') {
+        /* Arm before the title runs, not from the polling thread half a
+         * second later: a buffer allocated and filled during startup is
+         * written and finished with long before the first poll, so the
+         * watch saw an already-populated page and reported no writer. */
+        AddVectoredExceptionHandler(1, mw_handler);
+        mw_arm_from_file();
+        CloseHandle(CreateThread(NULL, 0, mw_thread, NULL, 0, NULL));
+    }
+}
