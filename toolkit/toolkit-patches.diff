+/* ---- sprite echoes ---------------------------------------------------------
+ * RECOMP_GPU_SPRITE_ECHO=0. A title can leave an afterimage behind a moving
+ * sprite by drawing it several times over, each copy further back and
+ * fainter (Red Ninja's logo and menu: nine copies while they move). With
+ * the option only the last copy of such a run is drawn, the sprite itself.
+ * A copy is a flat, alpha-blended, depth-less batch with the texture and
+ * vertex count of the one before it, whose vertex inputs other than the
+ * position are either the same as before (the texture coordinates) or one
+ * value for the whole batch (its colour). Sprites cut from one sheet differ
+ * in their coordinates and additive glows in their blending: those stay.
+ * The candidate is held back until the next thing drawn says which it was. */
+static int d3d_draw_vsh_now(const Nv2aGpuState *st, const Nv2aGpuVsh *vs,
+                            const float *in, uint32_t nverts,
+                            const uint32_t *idx, uint32_t nidx);
+#define ECHO_VERTS 64
+static struct {
+    int off, held, depth;
+    Nv2aGpuState st;
+    Nv2aGpuVsh vs;
+    uint32_t prog[136][4];
+    float consts[192][4];
+    float in[ECHO_VERTS * 64];
+    uint32_t idx[ECHO_VERTS * 6], nverts, nidx;
