+/* Apply the oldest unused capture for this pushbuffer, if there is one.
+ * Returns the number of entries written, or -1 when nothing was captured and
+ * the caller should fall back to reading the arena as it stands. */
+static int fix_snap_apply(uint32_t pbd, uint32_t fix, uint32_t pb_len)
+{
+    uint32_t i;
+    for (i = s_fsnap_tail; i != s_fsnap_head; i = (i + 1u) % FIX_SNAP_SLOTS) {
+        FixSnap *sl = &s_fsnap[i];
+        const uint32_t *fp;
+        uint32_t at = 0, guard = 0;
+        int n = 0;
+        if (sl->used || sl->pbd != pbd || sl->fix != fix)
+            continue;
+        sl->used = 1;
+        while (at + 8 <= sl->bytes && guard++ < 4096u) {
+            uint32_t size, off;
+            fp = (const uint32_t *)(s_fsnap_buf + sl->at + at);
+            size = fp[0]; off = fp[1];
+            if (size == 0xFFFFFFFFu)
+                break;
+            if (!size || size > 0x4000u || (size & 3u) || (off & 3u)
+                    || off >= pb_len || size > pb_len - off
+                    || at + 8 + size > sl->bytes)
+                break;
+            memcpy((uint8_t *)xbox_GetMemoryOffset() + pbd + off, fp + 2, size);
+            at += 8 + size;
+            n++;
+        }
+        while (s_fsnap_tail != s_fsnap_head && s_fsnap[s_fsnap_tail].used)
+            s_fsnap_tail = (s_fsnap_tail + 1u) % FIX_SNAP_SLOTS;
+        s_fsnap_taken++;
+        return n;
+    }
+    s_fsnap_missed++;
+    return -1;
+}
