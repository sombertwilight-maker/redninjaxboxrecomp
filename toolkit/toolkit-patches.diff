+static int echo_same(const Nv2aGpuState *st, const Nv2aGpuVsh *vs, const float *in, uint32_t nverts)
+{
+    uint32_t a, k = 0, v, shared = 0;
+    if (st->tex[0].offset != s_echo.st.tex[0].offset || st->color_va != s_echo.st.color_va
+            || nverts != s_echo.nverts || vs->in_mask != s_echo.vs.in_mask || vs->hash != s_echo.vs.hash)
+        return 0;
+    for (a = 0; a < 16; a++) {
+        const float *x, *y;
+        int same, flat = 1;
+        if (!(vs->in_mask & (1u << a))) continue;
+        x = in + k * 4; y = s_echo.in + k * 4; k++;
+        if (a == 0) {
+            /* A copy sits where the one before it sat, moved as a whole:
+             * every vertex by the same step (the title screen's logo slides
+             * 47 units a copy). A batch whose vertices move by different
+             * amounts is a new shape, not an echo -- the segments of a
+             * weapon trail, say -- and is drawn. */
+            float dx, dy, dz;
+            if (!nverts) return 0;
+            dx = x[0] - y[0]; dy = x[1] - y[1]; dz = x[2] - y[2];
+            for (v = 1; v < nverts; v++) {
+                const float *xv = x + v * vs->stride, *yv = y + v * vs->stride;
+                if (fabsf(xv[0] - yv[0] - dx) > 1e-3f || fabsf(xv[1] - yv[1] - dy) > 1e-3f
+                        || fabsf(xv[2] - yv[2] - dz) > 1e-3f)
+                    return 0;
+            }
+            continue;
+        }
+        same = 1;
+        for (v = 0; v < nverts; v++) {
+            if (memcmp(x + v * vs->stride, y + v * vs->stride, 16)) same = 0;
+            if (memcmp(x + v * vs->stride, x, 16) || memcmp(y + v * vs->stride, y, 16)) flat = 0;
+        }
+        if (same && !flat) shared = 1;
+        if (!same && !flat) return 0;
+        /* A trail leads up to the real thing, so each copy is at least as
+         * bright as the one before it (the title screen's run of nine goes
+         * from alpha 0.03 to 0.30). A pair that fades the other way, or
+         * that changes colour, is two things drawn in a row, not an echo:
+         * a weapon trail's segments, say. */
+        if (!same && flat)
