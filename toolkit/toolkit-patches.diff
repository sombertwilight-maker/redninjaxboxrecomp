+/* Video playback, for a title whose frame rate has been changed.
+ *
+ * An Xbox title plays its movies from .xmv files, and the decoder runs at the
+ * file's own rate. A port that doubles the game's frame rate leaves the movie
+ * where it was, so the extra flips present a buffer the decoder has not
+ * written into and the picture alternates between two frames -- Red Ninja's
+ * intro flickers exactly this way at 60. Knowing a movie file is open is
+ * enough for the title's side to put the rate back while one plays.
+ *
+ * Counted rather than a flag: a title may open the next movie before closing
+ * the last. */
+static volatile LONG s_movie_open;
+static HANDLE s_movie_handles[16];
+
+static int path_is_movie(const WCHAR *p)
+{
+    size_t n = p ? wcslen(p) : 0;
+    return n > 4 && (p[n - 4] == L'.')
+        && (p[n - 3] == L'x' || p[n - 3] == L'X')
+        && (p[n - 2] == L'm' || p[n - 2] == L'M')
+        && (p[n - 1] == L'v' || p[n - 1] == L'V');
+}
+
+static void movie_opened(HANDLE h)
+{
+    int i;
+    for (i = 0; i < 16; i++)
+        if (!s_movie_handles[i]) { s_movie_handles[i] = h; InterlockedIncrement(&s_movie_open); return; }
+}
+
+static void movie_closed(HANDLE h)
+{
+    int i;
+    for (i = 0; i < 16; i++)
+        if (s_movie_handles[i] == h) { s_movie_handles[i] = NULL; InterlockedDecrement(&s_movie_open); return; }
+}
+
+/* Non-zero while the title holds a video file open. */
+int xbox_MoviePlaying(void)
+{
+    return s_movie_open > 0;
+}
