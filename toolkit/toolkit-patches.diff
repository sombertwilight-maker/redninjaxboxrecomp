+        int k = item - MENU_T0;
+        if (k < s_ntopt) {
+            s_topt[k].value = (s_topt[k].value + dir + s_topt[k].n) % s_topt[k].n;
+            settings_save(s_topt[k].env, s_topt[k].value);
+        }
+        break;
+    }
+    case MENU_FPS:
+        g->show_fps = !g->show_fps;
+        settings_save("RECOMP_SHOW_FPS", g->show_fps);
+        break;
+    case MENU_DUMP:
+        g->tex_dump = !g->tex_dump;
+        if (g->tex_dump)
+            g->reload_seq++;             /* what is already loaded is saved too */
+        settings_save("RECOMP_TEX_DUMP", g->tex_dump);
+        break;
+    case MENU_REPLACE:
+        g->tex_replace = !g->tex_replace;
+        g->reload_seq++;                 /* textures already loaded change too */
+        settings_save("RECOMP_TEX_REPLACE", g->tex_replace);
+        break;
+    case MENU_RELOAD:
+        if (dir) g->reload_seq++;
+        break;
+    case MENU_CLOSE:
+        if (dir) s_menu_open = 0;
+        break;
+    }
+}
+
+/* Keys for the menu; returns 1 if the key is the menu's (it does not reach
+ * the game). F6 opens and closes it. */
+/* The menu's frame-rate choice (RECOMP_FPS60), for a title that has to
+ * adjust its own timing to match. */
+int xbox_GfxFps60(void) { return xbox_GfxConfig()->fps60; }
+
+/* The tab names along the top of the menu box, the open one bracketed. */
+static void menu_tabs(HDC dc, int x0, int y0, int pw, int fh, int lh)
+{
+    static const char *const names[3] = { "Graphics", "Effects", "Controls" };
+    RECT r = { x0 + fh, y0 + lh / 3, x0 + pw - fh, y0 + lh * 4 / 3 };
+    char t[32];
+    int i;
+    for (i = 0; i < 3; i++) {
+        SIZE sz;
+        snprintf(t, sizeof t, i == s_menu_tab ? "[ %s ]" : "%s", names[i]);
+        SetTextColor(dc, i == s_menu_tab ? RGB(255, 255, 255) : menu_rgb(160, 170, 210));
+        DrawTextA(dc, t, -1, &r, DT_LEFT | DT_SINGLELINE);
+        GetTextExtentPoint32A(dc, t, (int)strlen(t), &sz);
+        r.left += sz.cx + fh;
+    }
+}
+
+/* The Effects tab: rows 0..XBOX_FX_N-1 are settings, then "Reset" and
+ * "Close menu". */
+#define FX_ROWS (XBOX_FX_N + 2)
+static void fx_change(int row, int dir)
+{
+    XboxGfxConfig *g = xbox_GfxConfig();
+    int i;
+    if (row == XBOX_FX_N) {
+        if (!dir) return;
+        for (i = 1; i < XBOX_FX_N; i++) {
+            g->fx[i] = s_fx[i].def;
+            settings_save(s_fx[i].env, g->fx[i]);
+        }
+        return;
+    }
+    if (row > XBOX_FX_N) { if (dir) s_menu_open = 0; return; }
+    if (row == XBOX_FX_ON) g->fx[row] = !g->fx[row];
+    else {
+        int v = g->fx[row] + dir * s_fx[row].step;
+        g->fx[row] = v < s_fx[row].lo ? s_fx[row].lo : v > s_fx[row].hi ? s_fx[row].hi : v;
+    }
+    settings_save(s_fx[row].env, g->fx[row]);
+}
+
+/* One menu action, from the keyboard or the pad: 0 up, 1 down, 2 less,
+ * 3 more, 4 the other tab. */
+static void menu_act(int what)
+{
+    if (!s_pad_loaded) pad_load();
+    if (what == 4) { s_menu_tab = (s_menu_tab + 1) % 3; s_pad_capture = 0; return; }
+    if (s_menu_tab == 2) {
+        int i;
+        if (what == 0) s_pad_sel = (s_pad_sel + PAD_ROWS - 1) % PAD_ROWS;
+        else if (what == 1) s_pad_sel = (s_pad_sel + 1) % PAD_ROWS;
+        else if (s_pad_sel == PAD_N) {
+            for (i = 0; i < PAD_N; i++) { s_pad_map[i] = i; settings_save(s_pad_env[i], i); }
+            s_pad_any = 0;
+        } else if (s_pad_sel > PAD_N) s_menu_open = 0;
+        else if (what == 5) s_pad_capture = 1;                 /* then: the next button pressed */
+        else pad_bind(s_pad_sel, (s_pad_map[s_pad_sel] + (what == 2 ? PAD_N - 1 : 1)) % PAD_N);
+    } else if (s_menu_tab == 1) {
+        if (what == 0) s_fx_sel = (s_fx_sel + FX_ROWS - 1) % FX_ROWS;
+        else if (what == 1) s_fx_sel = (s_fx_sel + 1) % FX_ROWS;
+        else fx_change(s_fx_sel, what == 2 ? -1 : +1);
+    } else {
+        if (what == 0) s_menu_sel = menu_step(s_menu_sel, -1);
+        else if (what == 1) s_menu_sel = menu_step(s_menu_sel, +1);
+        else menu_change(s_menu_sel, what == 2 ? -1 : +1);
+    }
+}
+
+/* The menu from the controller: Back + Start opens and closes it; while it
+ * is open the d-pad moves and changes, A changes, B or Back closes, and the
+ * title sees no input (the caller blanks its report when this returns 1).
+ * `buttons` is the Xbox digital word, a and b the two analog buttons. */
+int xbox_MenuPadInput(unsigned buttons, const unsigned char *analog)
+{
+    static unsigned prev;
+    static int swallow;                 /* the opening or closing press, until let go */
+    static int cap_armed;               /* capture: everything was let go first */
+    static DWORD held_since, last_rep;
+    int a = analog[0] > 64, b = analog[1] > 64, y = analog[3] > 64;
+    unsigned cur = (buttons & 0x3F) | (a ? 0x100u : 0) | (b ? 0x200u : 0) | (y ? 0x400u : 0);
+    unsigned hit = cur & ~prev;
+    int combo = (cur & 0x30) == 0x30;
+    DWORD now = GetTickCount();
+    prev = cur;
+    if (combo && (hit & 0x30)) {
+        s_menu_open = !s_menu_open;
+        s_pad_capture = 0;
+        swallow = 1;
+        return 1;
+    }
+    if (swallow) {
+        if (cur & 0x330) return 1;
+        swallow = 0;
+    }
+    if (!s_menu_open)
+        return 0;
+    if (s_pad_capture) {
+        /* Binding: wait for empty hands, then take the first button down. */
+        int i, any = -1;
+        for (i = 0; i < 8 && any < 0; i++) if (analog[i] > 96) any = i;
+        for (i = 0; i < 8 && any < 0; i++) if (buttons & (1u << i)) any = 8 + i;
+        if (!cap_armed) { if (any < 0) cap_armed = 1; return 1; }
+        if (any >= 0) {
+            if (s_pad_sel < PAD_N) pad_bind(s_pad_sel, any);
+            s_pad_capture = 0; cap_armed = 0;
+            swallow = 1;                /* that press is not also a menu action */
+            prev = cur | 0x330;
+        }
+        return 1;
+    }
+    cap_armed = 0;
+    /* A held direction repeats, so a slider does not take a press a step. */
+    if (hit & 0xF) { held_since = now; last_rep = now; }
+    else if ((cur & 0xF) && s_menu_tab != 2 && now - held_since > 350 && now - last_rep > 45) { hit |= cur & 0xF; last_rep = now; }
+    if (hit & 0x1) menu_act(0);
+    if (hit & 0x2) menu_act(1);
+    if (hit & 0x4) menu_act(2);
+    if (hit & 0x8) menu_act(3);
+    if (hit & 0x100) menu_act(s_menu_tab == 2 && s_pad_sel < PAD_N ? 5 : 3);
+    if (hit & 0x400) menu_act(4);
+    if (hit & (0x200 | 0x20)) { s_menu_open = 0; swallow = 1; }
+    return 1;
+}
+
+static int menu_key(UINT m, WPARAM vk)
+{
+    int down = (m == WM_KEYDOWN || m == WM_SYSKEYDOWN);
+    if (vk == VK_F6) {
+        if (down) s_menu_open = !s_menu_open;
+        return 1;
+    }
+    if (!s_menu_open)
+        return 0;
+    if (vk != VK_UP && vk != VK_DOWN && vk != VK_LEFT && vk != VK_RIGHT
+        && vk != VK_RETURN && vk != VK_ESCAPE && vk != VK_SPACE && vk != VK_TAB)
+        return 0;
+    if (!down)
+        return 1;
+    switch (vk) {
+    case VK_UP:     menu_act(0); break;
+    case VK_DOWN:   menu_act(1); break;
+    case VK_LEFT:   menu_act(2); break;
+    case VK_RIGHT:
+    case VK_RETURN:
+    case VK_SPACE:  menu_act(s_menu_tab == 2 && s_pad_sel < PAD_N ? 5 : 3); break;
+    case VK_TAB:    menu_act(4); break;
+    case VK_ESCAPE: if (s_pad_capture) s_pad_capture = 0; else s_menu_open = 0; break;
+    }
+    return 1;
+}
+
+/* Set while the title has shown no new frame for a while (a save, a quit,
+ * a load that does not draw): a note says it is still working. */
+static int s_busy_note;
+
+static SRWLOCK s_pick_lock = SRWLOCK_INIT;
+static char s_pick_title[64], s_pick_hint[96], s_pick_items[XBOX_PICK_MAX][64];
+static int s_pick_n, s_pick_sel = -1;
+static volatile LONG s_pick_seq;
+
+void xbox_PickListShow(const char *title, const char *const *items, int n, int sel, const char *hint)
+{
+    int i;
+    if (n > XBOX_PICK_MAX) n = XBOX_PICK_MAX;
+    AcquireSRWLockExclusive(&s_pick_lock);
+    snprintf(s_pick_title, sizeof s_pick_title, "%s", title ? title : "");
+    snprintf(s_pick_hint, sizeof s_pick_hint, "%s", hint ? hint : "");
+    for (i = 0; i < n; i++)
+        snprintf(s_pick_items[i], sizeof s_pick_items[i], "%s", items[i]);
+    s_pick_n = n;
+    s_pick_sel = sel;
+    ReleaseSRWLockExclusive(&s_pick_lock);
+    InterlockedIncrement(&s_pick_seq);
+}
+
+void xbox_PickListHide(void)
+{
+    AcquireSRWLockExclusive(&s_pick_lock);
+    s_pick_sel = -1;
+    ReleaseSRWLockExclusive(&s_pick_lock);
+    InterlockedIncrement(&s_pick_seq);
+}
+
+static void pick_draw(HDC dc, int cw, int ch, int fh)
+{
+    int i, lh = fh * 3 / 2, pw, ph, x0, y0;
+    HBRUSH bg, hl;
+    HPEN pen, op;
+    HBRUSH ob;
+    (void)ch;
+    AcquireSRWLockShared(&s_pick_lock);
+    if (s_pick_sel < 0 || s_pick_n <= 0) {
+        ReleaseSRWLockShared(&s_pick_lock);
+        return;
+    }
+    pw = fh * 18;
+    ph = lh * (s_pick_n + 1) + fh * 2 + (s_pick_hint[0] ? lh : 0);
+    x0 = cw / 2 - pw / 2;
+    y0 = fh * 2;
+    bg = CreateSolidBrush(menu_rgb(16, 22, 48)); hl = CreateSolidBrush(menu_rgb(48, 70, 150));
+    pen = CreatePen(PS_SOLID, 2, menu_rgb(120, 150, 255));
+    op = (HPEN)SelectObject(dc, pen);
+    ob = (HBRUSH)SelectObject(dc, bg);
+    RoundRect(dc, x0, y0, x0 + pw, y0 + ph, fh, fh);
+    {
+        RECT r = { x0 + fh, y0 + lh / 3, x0 + pw - fh, y0 + lh * 4 / 3 };
+        SetTextColor(dc, RGB(255, 255, 255));
+        DrawTextA(dc, s_pick_title, -1, &r, DT_CENTER | DT_SINGLELINE | DT_NOPREFIX);
+    }
+    for (i = 0; i < s_pick_n; i++) {
+        RECT row = { x0 + fh / 2, y0 + lh * (i + 1) + fh / 2, x0 + pw - fh / 2, 0 };
+        row.bottom = row.top + lh;
+        if (i == s_pick_sel)
+            FillRect(dc, &row, hl);
+        row.left += fh / 2;
+        SetTextColor(dc, i == s_pick_sel ? RGB(255, 255, 255) : menu_rgb(210, 218, 245));
+        DrawTextA(dc, s_pick_items[i], -1, &row, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
+    }
+    if (s_pick_hint[0]) {
+        RECT r = { x0 + fh, y0 + lh * (s_pick_n + 1) + fh, x0 + pw - fh, y0 + ph - fh / 4 };
+        SetTextColor(dc, menu_rgb(160, 170, 210));
+        DrawTextA(dc, s_pick_hint, -1, &r, DT_CENTER | DT_SINGLELINE | DT_NOPREFIX);
+    }
+    ReleaseSRWLockShared(&s_pick_lock);
+    SelectObject(dc, op); SelectObject(dc, ob);
+    DeleteObject(pen); DeleteObject(bg); DeleteObject(hl);
+}
+
+static void overlay_draw(HDC dc, int cw, int ch)
+{
+    XboxGfxConfig *g = xbox_GfxConfig();
+    int fh = ch / 28 < 14 ? 14 : ch / 28;
+    HFONT font = CreateFontA(-fh, 0, 0, 0, FW_SEMIBOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                             CLEARTYPE_QUALITY, FF_SWISS, "Segoe UI");
+    HFONT old = (HFONT)SelectObject(dc, font);
+    char t[256];
+
+    SetBkMode(dc, TRANSPARENT);
+    if (s_busy_note) {
+        static const char *dots[4] = { "", ".", "..", "..." };
+        RECT r = { cw / 2 - fh * 6, ch - fh * 3, cw / 2 + fh * 6, ch - fh * 3 / 2 };
+        HBRUSH bb = CreateSolidBrush(menu_rgb(10, 12, 24));
+        FillRect(dc, &r, bb);
+        DeleteObject(bb);
+        snprintf(t, sizeof t, "Working, please wait%s", dots[(GetTickCount() / 400) & 3]);
+        SetTextColor(dc, menu_rgb(230, 235, 255));
+        DrawTextA(dc, t, -1, &r, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
+    }
+    if (g->show_fps || s_menu_open) {
+        RECT r;
+        snprintf(t, sizeof t, "%.1f FPS", s_fps_now);
+        r.left = cw - fh * 6; r.top = fh / 3; r.right = cw - fh / 2; r.bottom = r.top + fh * 3 / 2;
+        {
+            RECT b = r;
+            HBRUSH bb = CreateSolidBrush(menu_rgb(10, 12, 24));
+            b.left = r.right - fh * 9 / 2; b.right = r.right + fh / 4;
+            FillRect(dc, &b, bb);
+            DeleteObject(bb);
+        }
+        SetTextColor(dc, RGB(255, 255, 120));
+        DrawTextA(dc, t, -1, &r, DT_RIGHT | DT_SINGLELINE);
+    }
+    if (s_menu_open) {
+        /* The legend, beside the menu: what each key and button does. */
+        static const char *const rows[][3] = {
+            { "",                  "Keyboard",      "Controller" },
+            { "Open / close",      "F6",            "Back + Start" },
+            { "Switch tab",        "Tab",           "Y" },
+            { "Move",              "Up / Down",     "D-pad up / down" },
+            { "Change",            "Left / Right",  "D-pad left / right" },
+            { "",                  "(hold to slide)", "(hold to slide)" },
+            { "Next value / bind", "Enter / Space", "A" },
+            { "Close",             "Esc",           "B or Back" },
+        };
+        int n = (int)(sizeof rows / sizeof rows[0]), lh = fh * 5 / 4, i;
+        int x0 = fh + fh * 26 + fh / 2, y0 = fh, pw = fh * 21, ph = lh * (n + 1) + fh;
+        HBRUSH bg = CreateSolidBrush(menu_rgb(16, 22, 48));
+        HPEN pen = CreatePen(PS_SOLID, 2, menu_rgb(120, 150, 255));
+        HPEN op = (HPEN)SelectObject(dc, pen);
+        HBRUSH ob = (HBRUSH)SelectObject(dc, bg);
+        HFONT small = CreateFontA(-(fh * 4 / 5), 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                                  CLEARTYPE_QUALITY, FF_SWISS, "Segoe UI");
+        HFONT prev;
+        if (x0 + pw > cw - fh / 2) {            /* a narrow window: under the menu's corner instead */
+            x0 = cw - pw - fh / 2;
+            if (x0 < fh) x0 = fh;
+        }
+        Rectangle(dc, x0, y0, x0 + pw, y0 + ph);
+        {
+            RECT r = { x0 + fh * 3 / 4, y0 + lh / 3, x0 + pw - fh / 2, y0 + lh * 4 / 3 };
+            SetTextColor(dc, RGB(255, 255, 255));
+            DrawTextA(dc, "Controls", -1, &r, DT_LEFT | DT_SINGLELINE);
+        }
+        prev = (HFONT)SelectObject(dc, small);
+        for (i = 0; i < n; i++) {
+            RECT r = { x0 + fh * 3 / 4, y0 + lh * (i + 1) + lh / 2, x0 + pw - fh / 2, 0 };
+            r.bottom = r.top + lh;
+            SetTextColor(dc, menu_rgb(160, 170, 210));
+            DrawTextA(dc, rows[i][0], -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+            SetTextColor(dc, i ? RGB(255, 230, 140) : menu_rgb(230, 235, 255));
+            r.left = x0 + fh * 6;
+            DrawTextA(dc, rows[i][1], -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+            r.left = x0 + fh * 13;
+            DrawTextA(dc, rows[i][2], -1, &r, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+        }
+        SelectObject(dc, prev);
+        DeleteObject(small);
+        SelectObject(dc, op); SelectObject(dc, ob);
+        DeleteObject(pen); DeleteObject(bg);
+    }
+    if (s_menu_open && s_menu_tab == 2) {
+        int pw = fh * 26, lh = fh * 5 / 4, ph = lh * (PAD_ROWS + 2) + fh * 3, x0 = fh, y0 = fh, i;
+        RECT box = { x0, y0, x0 + pw, y0 + ph };
+        HBRUSH bg = CreateSolidBrush(menu_rgb(16, 22, 48)), hl = CreateSolidBrush(menu_rgb(48, 70, 150));
+        HPEN pen = CreatePen(PS_SOLID, 2, menu_rgb(120, 150, 255));
+        HPEN op = (HPEN)SelectObject(dc, pen);
+        HBRUSH ob = (HBRUSH)SelectObject(dc, bg);
+        if (!s_pad_loaded) pad_load();
