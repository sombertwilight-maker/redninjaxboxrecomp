+           || s_fsnap_pos + bytes > FIX_SNAP_BYTES) {
+        if (s_fsnap_head == s_fsnap_tail) { s_fsnap_pos = 0; break; }
+        s_fsnap_tail = (s_fsnap_tail + 1u) % FIX_SNAP_SLOTS;
+        s_fsnap_dropped++;
