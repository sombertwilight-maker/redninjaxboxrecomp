+    if (mode == 1)
+        return XBOX_CONTIG_BASE + (param & (XBOX_CONTIG_SIZE - 1u));
+    if (mode == 2)
+        return param & (XBOX_CONTIG_SIZE - 1u);
+    return dma_resolve(param);
