+ * of C++ object pointers, which decode as denormal floats and throw the
+ * geometry across the screen.
+ *
+ * RECOMP_VTX_SPACE=win forces the window, =ram forces RAM; unset keeps the
+ * guess. One run each says which store the title's vertices are really in. */
+static uint32_t vtx_resolve(uint32_t param)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char *e = getenv("RECOMP_VTX_SPACE");
+        mode = e && !strcmp(e, "win") ? 1 : (e && !strcmp(e, "ram") ? 2 : 0);
