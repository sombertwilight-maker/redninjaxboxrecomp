+                continue;
+            }
+            if (s_pad_action[i][0]) snprintf(t, sizeof t, "%s  -  %s", s_pad_game[i], s_pad_action[i]);
+            else snprintf(t, sizeof t, "%s", s_pad_game[i]);
+            DrawTextA(dc, t, -1, &rl, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+            if (s_pad_capture && i == s_pad_sel) snprintf(t, sizeof t, "press a button...");
+            else snprintf(t, sizeof t, "< %s >", s_pad_phys[s_pad_map[i]]);
+            SetTextColor(dc, s_pad_map[i] != i || (s_pad_capture && i == s_pad_sel) ? RGB(255, 230, 140) : menu_rgb(160, 170, 210));
+            DrawTextA(dc, t, -1, &rv, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);
+        }
+        {
+            RECT r = { x0 + fh, y0 + lh * (PAD_ROWS + 2) + fh / 3, x0 + pw - fh, y0 + ph - fh / 4 };
+            HFONT small = CreateFontA(-(fh * 4 / 5), 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                                      CLEARTYPE_QUALITY, FF_SWISS, "Segoe UI");
+            HFONT prev = (HFONT)SelectObject(dc, small);
+            SetTextColor(dc, menu_rgb(160, 170, 210));
+            DrawTextA(dc, "Left: the game's button.  Right: the button on your pad that presses it.\n"
+                          "A or Enter, then press the button you want.  Left/Right steps through them.\n"
+                          "The sticks are not rebound.  This menu always uses the pad's own buttons.",
+                      -1, &r, DT_LEFT | DT_NOPREFIX);
+            SelectObject(dc, prev);
+            DeleteObject(small);
+        }
+        SelectObject(dc, op); SelectObject(dc, ob);
+        DeleteObject(pen); DeleteObject(bg); DeleteObject(hl);
+    } else if (s_menu_open && s_menu_tab) {
+        int pw = fh * 26, lh = fh * 3 / 2, ph = lh * (FX_ROWS + 2) + fh * 3, x0 = fh, y0 = fh, i;
+        RECT box = { x0, y0, x0 + pw, y0 + ph };
+        HBRUSH bg = CreateSolidBrush(menu_rgb(16, 22, 48)), hl = CreateSolidBrush(menu_rgb(48, 70, 150));
+        HBRUSH bar = CreateSolidBrush(menu_rgb(120, 150, 255)), trk = CreateSolidBrush(menu_rgb(10, 12, 24));
+        HPEN pen = CreatePen(PS_SOLID, 2, menu_rgb(120, 150, 255));
+        HPEN op = (HPEN)SelectObject(dc, pen);
+        HBRUSH ob = (HBRUSH)SelectObject(dc, bg);
+        Rectangle(dc, box.left, box.top, box.right, box.bottom);
+        menu_tabs(dc, x0, y0, pw, fh, lh);
+        for (i = 0; i < FX_ROWS; i++) {
+            RECT row = { x0 + fh / 2, y0 + lh * (i + 1) + lh / 2, x0 + pw - fh / 2, 0 };
+            RECT rl, rv;
+            row.bottom = row.top + lh;
+            if (i == s_fx_sel)
+                FillRect(dc, &row, hl);
+            rl = row; rl.left += fh / 2;
+            rv = row; rv.right -= fh / 2;
+            SetTextColor(dc, menu_rgb(230, 235, 255));
+            DrawTextA(dc, i < XBOX_FX_N ? s_fx[i].label : i == XBOX_FX_N ? "Reset effects to defaults" : "Close menu",
+                      -1, &rl, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+            if (i >= XBOX_FX_N) continue;
+            if (i == XBOX_FX_ON) snprintf(t, sizeof t, "%s", g->fx[i] ? (g->gpu_active ? "On" : "On (needs the GPU renderer)") : "Off");
+            else {
+                /* A slider: track, fill up to the value, the number beside it. */
+                RECT tr = { row.left + fh * 11, row.top + lh * 3 / 8, row.right - fh * 4, row.bottom - lh * 3 / 8 };
+                RECT fl = tr;
+                fl.right = tr.left + (tr.right - tr.left) * (g->fx[i] - s_fx[i].lo) / (s_fx[i].hi - s_fx[i].lo);
+                FillRect(dc, &tr, trk);
+                FillRect(dc, &fl, bar);
