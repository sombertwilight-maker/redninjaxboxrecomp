+
+static void echo_flush(void)
+{
+    if (s_echo.held) {
+        s_echo.held = 0;
+        d3d_draw_vsh_now(&s_echo.st, &s_echo.vs, s_echo.in, s_echo.nverts, s_echo.idx, s_echo.nidx);
+    }
+}
