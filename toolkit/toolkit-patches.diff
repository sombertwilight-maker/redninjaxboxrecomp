+    pb_len = *(volatile uint32_t *)(mem + pb_desc + 0xC);
+    base   = *(volatile uint32_t *)(mem + fixup_obj + 4);
+    start  = *(volatile uint32_t *)(mem + fixup_obj + 0xC);
+    used   = *(volatile uint32_t *)(mem + fixup_obj + 0x10);
